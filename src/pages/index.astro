---
const fases = [
  {
    n: "1",
    nombre: "Comprensión del problema",
    texto: "El grupo elige un problema real de su comunidad y lo estudia a fondo: qué lo causa, a quién afecta y qué consecuencias tiene.",
    aula: "Identificar el problema, sus causas y sus consecuencias.",
  },
  {
    n: "2",
    nombre: "Elaboración de actividades",
    texto: "Se diseña la solución y se planifica el trabajo paso a paso, con un cronograma de actividades por semana.",
    aula: "Armar el cuadro de actividades y el cronograma.",
  },
  {
    n: "3",
    nombre: "Ejecución de actividades",
    texto: "Se construye y programa el prototipo o maqueta con mBlock y una tarjeta programable con sensores.",
    aula: "Construir, programar y presentar el prototipo.",
  },
  {
    n: "4",
    nombre: "Revisión de la solución",
    texto: "Se revisa qué falta en el programa y en la maqueta, se corrige y el trabajo se expone ante la clase.",
    aula: "Evaluar, corregir y exponer al cierre de las 18 sesiones.",
  },
];

const proyectos = [
  {
    titulo: "Monitoreo y alerta de turbidez del agua",
    quien: "Estudiantes de la I.E. Mariscal Cáceres, Daniel Hernández",
    dato: "2.º puesto en la Feria Eureka, etapa regional",
  },
  {
    titulo: "Calidad del agua para prevenir infecciones estomacales en Ustuna",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Caso publicado en Sustainability (2025)",
  },
  {
    titulo: "Calidad del aire en casas con cocina a leña",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Simulaciones interactivas en quechua con mBlock",
  },
  {
    titulo: "Control del nivel de ruido en la biblioteca",
    quien: "UNAT, sensor de sonido KY-037",
    dato: "Publicado en la revista Llamkasun",
  },
];

const fuentes = [
  {
    t: "IBPT: An Approach to Promote Research and Technological Competencies in Higher Education",
    d: "Paucar-Curasma, Unsihuay Tovar, Acra-Despradel y Villalba-Condori. Sustainability 17(20), 9309, 2025.",
    u: "https://doi.org/10.3390/su17209309",
  },
  {
    t: "Enfoque IBPT en educación semipresencial",
    d: "Paucar Curasma. EduTicInnova 13(1), 85-93, 2025.",
    u: "https://portalrevistas.aulavirtualusmp.pe/index.php/eduticinnova/article/view/3323",
  },
  {
    t: "Promoting gender equality through computational thinking and STEM activities",
    d: "Revista AiBi, 2025.",
    u: "https://revistas.udes.edu.co/aibi/en/article/view/4073",
  },
  {
    t: "Control y monitoreo del nivel de ruido con el sensor KY-037",
    d: "Revista Llamkasun, UNAT.",
    u: "https://llamkasun.unat.edu.pe/index.php/revista/article/view/143",
  },
  {
    t: "Perfil de Ronald Paucar Curasma",
    d: "ResearchGate.",
    u: "https://www.researchgate.net/profile/Ronald-Paucar-Curasma",
  },
  {
    t: "Página IBPT-STEM",
    d: "Facebook, publicaciones del taller y videos de aula.",
    u: "https://www.facebook.com/ibptstem",
  },
];

const icons = [
  '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>',
  '<path d="M6 3h9l4 4v14H6z"/><path d="M9 10h7M9 14h7M9 18h4"/>',
  '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1"/>',
  '<path d="M8 4h8v3H8z"/><path d="M6 5.5H4.5V21h15V5.5H18"/><path d="m8.5 14 2.5 2.5 4.5-5"/>',
];
const steam = [
  ["Ciencia", '<path d="M9 3h6M10 3v6l-5 9.5A1.7 1.7 0 0 0 6.5 21h11a1.7 1.7 0 0 0 1.5-2.5L14 9V3"/>'],
  ["Tecnología", '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/>'],
  ["Ingeniería", '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>'],
  ["Arte", '<path d="M12 3a9 9 0 1 0 0 18c1.2 0 1.8-.9 1.4-2-.5-1.2.3-2.3 1.6-2.3H17a4 4 0 0 0 4-4C21 7 17 3 12 3z"/><circle cx="7.5" cy="11" r="1"/><circle cx="10" cy="7" r="1"/><circle cx="15" cy="7.5" r="1"/>'],
  ["Matemática", '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 8h4M9 6v4M14 8h4M7 15h4M14 14h4M14 17h4"/>'],
];
const arbol = {
  consecuencias: ["Las familias se enferman con frecuencia", "Problemas de salud", "Mal olor y sabor desagradable", "Enfermedades diarreicas agudas", "Afecta la fotosíntesis de plantas acuáticas y peces"],
  problema: "Agua turbia en el consumo diario",
  causas: ["Partículas suspendidas que protegen a los microorganismos"],
};
const kit = [
  ["#f5c400", "Amarillo"], ["#e63329", "Rojo"], ["#1f9d4c", "Verde"], ["#ffffff", "Blanco"], ["#1d5fd6", "Azul"], ["#1a1a1a", "Negro"],
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/img/logo.png" />
    <title>Modelo IBPT-STEM | Investigación Basada en Problemas y Tecnología</title>
    <meta name="description" content="Modelo pedagógico creado por el Dr. Ronald Paucar Curasma en la Universidad Nacional Autónoma de Tayacaja." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Figtree:wght@400;500;600;700&family=Caveat:wght@600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-in">
        <a class="brand" href="#"><img src="/img/logo.png" alt="" width="40" height="40" /><span>IBPT-<b>STEM</b></span></a>
        <nav>
          <a href="#fases">Fases</a>
          <a href="#arbol">Árbol de problemas</a>
          <a href="#kit">Kit</a>
          <a href="#proyectos">Proyectos</a>
          <a href="#bibliografia">Bibliografía</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap hero-in">
          <div class="hero-copy">
            <p class="hand">Innovar para una mejor educación</p>
            <h1>Modelo <span class="ibpt">IBPT</span>-<span class="s">S</span><span class="t">T</span><span class="e">E</span><span class="m">M</span></h1>
            <p class="pill">4 fases y Kit Educativo STEM</p>
            <p class="lead">
              Investigación Basada en Problemas y Tecnología. Un modelo pedagógico creado por el Dr. Ronald Paucar Curasma
              en la Universidad Nacional Autónoma de Tayacaja, Huancavelica, para que los estudiantes investiguen los
              problemas de su comunidad y construyan soluciones con tecnología.
            </p>
            <div class="cta">
              <a class="btn" href="#fases">Conocer las fases</a>
              <a class="btn ghost" href="https://www.facebook.com/ibptstem" target="_blank" rel="noopener">Ver en Facebook</a>
            </div>
          </div>
          <figure class="hero-kit">
            <img src="/img/kit.jpg" alt="Kits Yachayboard en seis colores, con sensores, pantallas y placas" width="640" height="360" />
            <figcaption class="hand">Yachayboard, el kit del modelo</figcaption>
          </figure>
        </div>
        <ul class="wrap steam">
          {steam.map(([n, ic]) => (
            <li><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic}></svg>{n}</li>
          ))}
        </ul>
      </section>

      <section class="wrap facts">
        <div><b>18</b><span>sesiones por proyecto</span></div>
        <div><b>2</b><span>idiomas: castellano y quechua</span></div>
        <div><b>4</b><span>fases del modelo</span></div>
        <div><b>2.º</b><span>puesto en Eureka regional</span></div>
      </section>

      <section id="fases" class="wrap block">
        <p class="eyebrow">Cómo se trabaja</p>
        <h2>Las 4 fases del modelo</h2>
        <ol class="phases">
          {fases.map((f, i) => (
            <li class={i % 2 ? "g" : "b"}>
              <span class="n">{f.n}</span>
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i]}></svg>
              <h3>{f.nombre}</h3>
              <p>{f.texto}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="arbol" class="tree-sec">
        <div class="wrap tree-in">
          <div class="tree-copy">
            <p class="eyebrow">Fase 1 en el aula</p>
            <h2>El árbol de problemas</h2>
            <p>
              En la primera fase, los estudiantes dibujan el problema como un árbol. Las raíces son las causas, el tronco es
              el problema y las ramas son las consecuencias. Este es el de un grupo que investigó la turbidez del agua.
            </p>
            <p class="hint">Tocá cada parte del árbol.</p>
            <figure class="orig">
              <img src="/img/arbol.jpg" alt="Papelógrafo original del árbol de problemas hecho por estudiantes" width="330" height="370" />
              <figcaption>El papelógrafo original</figcaption>
            </figure>
          </div>
          <div class="ptree" data-part="consecuencias">
            <div class="canvas">
              <svg viewBox="0 0 600 600" aria-hidden="true">
                <defs>
                  <linearGradient id="bark" x1="0" x2="1">
                    <stop offset="0" stop-color="#6b4226" /><stop offset="0.5" stop-color="#94603a" /><stop offset="1" stop-color="#6b4226" />
                  </linearGradient>
                </defs>
                <g class="g-roots" data-part="causas">
                  <path class="draw" d="M300 420 C 300 470, 250 480, 200 530" />
                  <path class="draw" d="M300 420 C 305 480, 330 500, 400 540" />
                  <path class="draw" d="M300 420 C 298 470, 300 510, 296 570" />
                  <path class="draw thin" d="M262 470 C 240 480, 220 470, 180 480" />
                  <path class="draw thin" d="M335 480 C 360 485, 390 480, 430 490" />
                </g>
                <line class="ground" x1="110" y1="420" x2="490" y2="420" />
                <g class="g-trunk" data-part="problema">
                  <path d="M268 422 C 276 360, 280 300, 278 250 L 322 250 C 320 300, 324 360, 332 422 Z" fill="url(#bark)" />
                  <path class="branch" d="M286 262 C 260 230, 220 210, 170 190" />
                  <path class="branch" d="M314 262 C 340 230, 380 210, 430 190" />
                  <path class="branch" d="M300 252 C 300 210, 298 170, 300 120" />
                  <path class="branch thin" d="M296 205 C 270 180, 250 150, 230 120" />
                  <path class="branch thin" d="M304 200 C 330 175, 350 150, 372 122" />
                </g>
                <g class="g-crown" data-part="consecuencias">
                  {[
                    [300, 95, 92], [195, 150, 86], [405, 150, 86], [130, 230, 70], [470, 230, 70],
                    [250, 215, 90], [350, 215, 90], [300, 160, 80], [215, 85, 60], [385, 85, 60],
                  ].map(([cx, cy, r], i) => (
                    <circle class={`leafc l${i % 3}`} cx={cx} cy={cy} r={r} style={`--i:${i}`} />
                  ))}
                </g>
              </svg>
              {arbol.consecuencias.map((c, i) => (
                <button class="tag pink" data-part="consecuencias" style={`--x:${[50, 21, 80, 31, 69][i]}%; --y:${[8, 21, 17, 36, 41][i]}%; --r:${[-2, 3, -3, 2, -1.5][i]}deg; --i:${i}`}>{c}</button>
              ))}
              <button class="tag lilac big" data-part="problema" style="--x:50%; --y:57%; --r:-1deg; --i:5"><small>Problema</small>{arbol.problema}</button>
              {arbol.causas.map((c) => (
                <button class="tag lilac" data-part="causas" style="--x:50%; --y:88%; --r:1.5deg; --i:6"><small>Causa</small>{c}</button>
              ))}
              <span class="label l-cons" aria-hidden="true">consecuencias</span>
              <span class="label l-prob" aria-hidden="true">problema</span>
              <span class="label l-caus" aria-hidden="true">causas</span>
            </div>
            <p class="legend" aria-live="polite" id="legend">Consecuencias: lo que el problema provoca en la comunidad.</p>
          </div>
        </div>
      </section>

      <section id="kit" class="wrap block kit">
        <div class="kit-copy">
          <p class="eyebrow">Kit Educativo STEM</p>
          <h2>Yachayboard</h2>
          <p>
            <i>Yachay</i> significa aprender en quechua. Es el kit circular con el que los estudiantes arman sus prototipos:
            placas programables, sensores, pantallas, matrices de LED y botones, que se programan por bloques con mBlock.
          </p>
          <ul class="discs">
            {kit.map(([c, n]) => <li style={`--c:${c}`}><span></span>{n}</li>)}
          </ul>
        </div>
        <div class="kit-cards">
          <div class="mini"><b>mBlock</b><span>programación visual por bloques</span></div>
          <div class="mini"><b>Sensores</b><span>turbidez, sonido, humedad, temperatura</span></div>
          <div class="mini"><b>Quechua</b><span>interfaces y simulaciones en la lengua de los estudiantes</span></div>
        </div>
      </section>

      <section class="quote">
        <div class="wrap">
          <blockquote>
            <p>“Debemos conocer muy bien el problema que vamos a investigar, sus causas, sus consecuencias.”</p>
            <cite>Amelia Pacheco Carhuaricra, docente de 5.º de secundaria, I.E. Mariscal Cáceres</cite>
          </blockquote>
        </div>
      </section>

      <section id="proyectos" class="wrap block">
        <p class="eyebrow">Resultados</p>
        <h2>Proyectos con el modelo</h2>
        <div class="projects">
          {proyectos.map((p, i) => (
            <article style={`--c:${kit[i][0] === "#ffffff" ? "#1d5fd6" : kit[[1, 4, 2, 0][i]][0]}`}>
              <span class="dot"></span>
              <h3>{p.titulo}</h3>
              <p>{p.quien}</p>
              <p class="badge">{p.dato}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="wrap block teach">
        <div>
          <p class="eyebrow">Formación docente</p>
          <h2>Red Peruana IBPT-STEM</h2>
        </div>
        <div class="teach-txt">
          <p>
            La UNAT dicta el taller “Fortalecimiento de competencias en el área de Ciencia y Tecnología mediante el modelo
            IBPT-STEM” para docentes de Tayacaja. En las jornadas programan en castellano y quechua, trabajan el enfoque STEM y
            comparten sus experiencias de aula.
          </p>
          <p>
            En la universidad, los estudios publicados muestran mejoras significativas en todas las fases en estudiantes de
            Ingeniería y Enfermería.
          </p>
        </div>
      </section>

      <section id="bibliografia" class="wrap block">
        <p class="eyebrow">Para leer más</p>
        <h2>Bibliografía</h2>
        <ul class="refs">
          {fuentes.map((s) => (
            <li><a href={s.u} target="_blank" rel="noopener">{s.t}</a><span>{s.d}</span></li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <p class="hand big">Aprender hoy para construir mañana</p>
        <div>
          <p>Sitio informativo no oficial, armado con fuentes públicas en octubre de 2026.</p>
          <p>Contacto del autor del modelo: rpaucarc@unat.edu.pe</p>
        </div>
      </div>
    </footer>

    <script>
      const tree = document.querySelector(".ptree") as HTMLElement;
      const legend = document.getElementById("legend")!;
      const text: Record<string, string> = {
        consecuencias: "Consecuencias: lo que el problema provoca en la comunidad.",
        problema: "Problema: lo que el grupo decide investigar.",
        causas: "Causas: por qué ocurre el problema.",
      };
      const set = (part: string) => { tree.dataset.part = part; legend.textContent = text[part]; };
      tree.querySelectorAll<HTMLElement>("[data-part]").forEach((el) => {
        if (el === tree) return;
        el.addEventListener("pointerenter", () => set(el.dataset.part!));
        el.addEventListener("click", () => set(el.dataset.part!));
        el.addEventListener("focus", () => set(el.dataset.part!));
      });
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        tree.classList.add("will-grow");
        const io = new IntersectionObserver(([e]) => {
          if (e.isIntersecting) { tree.classList.add("grow"); io.disconnect(); }
        }, { threshold: 0.35 });
        io.observe(tree);
        setTimeout(() => tree.classList.add("settled"), 0);
        tree.addEventListener("transitionend", () => tree.classList.add("settled"), { once: false });
      }
    </script>
  </body>
</html>

<style is:global>
  /* Layout: el lenguaje del banner oficial; marino de base, azul y verde que se alternan, STEM en los colores del logo */
  :root {
    --navy: #0b2a6f;
    --blue: #1d6fe0;
    --sky: #e7f1fd;
    --green: #22a04b;
    --mint: #e8f6ec;
    --orange: #f28a1c;
    --purple: #7b3fb5;
    --ink: #13213f;
    --muted: #5b6886;
    --bg: #ffffff;
    --line: #dfe7f3;
    --display: "Montserrat", "Arial Black", system-ui, sans-serif;
    --body: "Figtree", system-ui, sans-serif;
    --hand: "Caveat", "Comic Sans MS", cursive;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 17px/1.6 var(--body); }
  img { max-width: 100%; height: auto; display: block; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; border-radius: 6px; }
  .wrap { max-width: 1160px; margin: 0 auto; padding-inline: max(20px, 4vw); }
  h1, h2, h3 { font-family: var(--display); margin: 0; line-height: 1.08; text-wrap: balance; color: var(--navy); }
  h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -0.02em; }
  h3 { font-size: 1.15rem; font-weight: 800; }
  p { margin: 0; }
  .eyebrow { font-weight: 700; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue); margin-bottom: 10px; }
  .hand { font-family: var(--hand); font-weight: 600; color: var(--navy); font-size: 1.6rem; line-height: 1.1; }
  .block { padding-block: 88px; }

  .nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: rgb(255 255 255 / 0.88); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 10px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--display); font-weight: 900; color: var(--navy); font-size: 1.1rem; }
  .brand b { color: var(--green); }
  .nav nav { display: flex; gap: 22px; flex-wrap: wrap; font-weight: 600; font-size: 0.95rem; }
  .nav nav a { text-decoration: none; color: var(--muted); transition: color 150ms ease; }
  .nav nav a:hover { color: var(--blue); }

  .hero { background: linear-gradient(180deg, var(--sky), #fff 78%); padding-top: 56px; overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; }
  .hero-copy { min-width: 0; }
  .hero .hand { transform: rotate(-3deg); display: inline-block; margin-bottom: 10px; }
  h1 { font-size: clamp(3rem, 7.4vw, 5.6rem); font-weight: 900; letter-spacing: -0.035em; }
  h1 .ibpt { color: var(--blue); }
  h1 .s { color: var(--green); } h1 .t { color: #3aa53f; } h1 .e { color: var(--orange); } h1 .m { color: var(--purple); }
  .pill { display: inline-block; margin-top: 18px; background: #d6e7fc; color: var(--navy); font-family: var(--display); font-weight: 800; font-size: clamp(1rem, 2vw, 1.3rem); padding: 8px 20px; border-radius: 999px; }
  .lead { margin-top: 22px; color: var(--muted); font-size: 1.1rem; max-width: 54ch; }
  .cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; padding: 13px 22px; border-radius: 999px; background: var(--navy); color: #fff; font-weight: 700; text-decoration: none; transition: transform 160ms var(--ease-out), background 150ms ease; }
  .btn:hover { background: var(--blue); }
  .btn:active { transform: scale(0.97); }
  .btn.ghost { background: transparent; color: var(--navy); box-shadow: inset 0 0 0 2px var(--navy); }
  .btn.ghost:hover { background: var(--navy); color: #fff; }
  .hero-kit { margin: 0; position: relative; }
  .hero-kit img { border-radius: 28px; box-shadow: 0 24px 48px -24px rgb(11 42 111 / 0.35); }
  .hero-kit figcaption { position: absolute; right: 12px; bottom: -40px; transform: rotate(-2deg); font-size: 1.4rem; }

  .steam { list-style: none; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; margin: 72px auto 0; padding-block: 24px; border-top: 1px solid var(--line); }
  .steam li { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--navy); text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; }
  .steam svg { width: 26px; height: 26px; fill: none; stroke: var(--blue); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-block: 48px 0; }
  .facts div { background: var(--sky); border-radius: 20px; padding: 22px; display: flex; flex-direction: column; }
  .facts div:nth-child(even) { background: var(--mint); }
