---
const fases = [
  {
    n: "1",
    nombre: "Comprensión del problema",
    texto: "El grupo elige un problema real de su comunidad y lo estudia a fondo: qué lo causa, a quién afecta y qué consecuencias tiene.",
    aula: "Identificar el problema, sus causas y sus consecuencias.",
  },
  {
    n: "2",
    nombre: "Elaboración de actividades",
    texto: "Se diseña la solución y se planifica el trabajo paso a paso, con un cronograma de actividades por semana.",
    aula: "Armar el cuadro de actividades y el cronograma.",
  },
  {
    n: "3",
    nombre: "Ejecución e implementación",
    texto: "Se construye y programa el prototipo o maqueta con mBlock y una tarjeta programable con sensores.",
    aula: "Construir, programar y presentar el prototipo.",
  },
  {
    n: "4",
    nombre: "Revisión y evaluación",
    texto: "Se revisa qué falta en el programa y en la maqueta, se corrige y el trabajo se expone ante la clase.",
    aula: "Evaluar, corregir y exponer al cierre de las 18 sesiones.",
  },
];

const proyectos = [
  {
    titulo: "Monitoreo y alerta de turbidez del agua",
    quien: "Estudiantes de la I.E. Mariscal Cáceres, Daniel Hernández",
    dato: "2.º puesto en la Feria Eureka, etapa regional",
  },
  {
    titulo: "Calidad del agua para prevenir infecciones estomacales en Ustuna",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Caso publicado en Sustainability (2025)",
  },
  {
    titulo: "Calidad del aire en casas con cocina a leña",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Simulaciones interactivas en quechua con mBlock",
  },
  {
    titulo: "Control del nivel de ruido en la biblioteca",
    quien: "UNAT, sensor de sonido KY-037",
    dato: "Publicado en la revista Llamkasun",
  },
];

const fuentes = [
  {
    t: "IBPT: An Approach to Promote Research and Technological Competencies in Higher Education",
    d: "Paucar-Curasma, Unsihuay Tovar, Acra-Despradel y Villalba-Condori. Sustainability 17(20), 9309, 2025.",
    u: "https://doi.org/10.3390/su17209309",
  },
  {
    t: "Enfoque IBPT en educación semipresencial",
    d: "Paucar Curasma. EduTicInnova 13(1), 85-93, 2025.",
    u: "https://portalrevistas.aulavirtualusmp.pe/index.php/eduticinnova/article/view/3323",
  },
  {
    t: "Promoting gender equality through computational thinking and STEM activities",
    d: "Revista AiBi, 2025.",
    u: "https://revistas.udes.edu.co/aibi/en/article/view/4073",
  },
  {
    t: "Control y monitoreo del nivel de ruido con el sensor KY-037",
    d: "Revista Llamkasun, UNAT.",
    u: "https://llamkasun.unat.edu.pe/index.php/revista/article/view/143",
  },
  {
    t: "Perfil de Ronald Paucar Curasma",
    d: "ResearchGate.",
    u: "https://www.researchgate.net/profile/Ronald-Paucar-Curasma",
  },
  {
    t: "Página IBPT-STEM",
    d: "Facebook, publicaciones del taller y videos de aula.",
    u: "https://www.facebook.com/ibptstem",
  },
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>IBPT-STEM | Investigación Basada en Problemas y Tecnología</title>
    <meta name="description" content="Modelo pedagógico creado por el Dr. Ronald Paucar Curasma en la Universidad Nacional Autónoma de Tayacaja." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Public+Sans:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="weave" aria-hidden="true"></div>
    <header class="wrap top">
      <a class="logo" href="#">IBPT-STEM</a>
      <nav>
        <a href="#modelo">Modelo</a>
        <a href="#fases">Fases</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#bibliografia">Bibliografía</a>
      </nav>
    </header>

    <main>
      <section class="wrap hero">
        <p class="eyebrow">Universidad Nacional Autónoma de Tayacaja Daniel Hernández Morillo</p>
        <h1>Investigación Basada en Problemas y Tecnología</h1>
        <div class="hero-cols">
          <p class="lead">
            IBPT-STEM es un modelo pedagógico creado por el Dr. Ronald Paucar Curasma para enseñar Ciencia y Tecnología
            desde los problemas reales de la comunidad. Los estudiantes de Tayacaja investigan un problema de su entorno,
            diseñan una solución y la convierten en un prototipo programado.
          </p>
          <dl class="meta">
            <div><dt>Herramienta</dt><dd>mBlock y tarjetas con sensores</dd></div>
            <div><dt>Idiomas</dt><dd>Castellano y quechua</dd></div>
            <div><dt>Duración</dt><dd>18 sesiones por proyecto</dd></div>
            <div><dt>Niveles</dt><dd>Secundaria y pregrado</dd></div>
          </dl>
        </div>
      </section>

      <section id="modelo" class="wrap quote-sec">
        <blockquote>
          <p>“Debemos conocer muy bien el problema que vamos a investigar, sus causas, sus consecuencias.”</p>
          <cite>Amelia Pacheco Carhuaricra, docente de 5.º de secundaria en la I.E. Mariscal Cáceres, explicando la primera fase a su clase</cite>
        </blockquote>
      </section>

      <section id="fases" class="wrap">
        <div class="sec-head">
          <h2>Las cuatro fases</h2>
          <p>El modelo une el método de resolución de problemas con recursos tecnológicos al alcance de un colegio de provincia.</p>
        </div>
        <ol class="fases">
          {fases.map((f) => (
            <li>
              <span class="num">{f.n}</span>
              <h3>{f.nombre}</h3>
              <p>{f.texto}</p>
              <p class="aula">En el aula: {f.aula}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="wrap lab-sec">
        <div class="sec-head">
          <h2>Un proyecto, de cerca</h2>
          <p>
            Estudiantes de la I.E. Mariscal Cáceres construyeron un sistema que mide la turbidez del agua y da la alerta cuando
            deja de ser apta. Con él obtuvieron el 2.º puesto en la etapa regional de la Feria Eureka. Mové el control para ver
            cómo responde.
          </p>
        </div>
        <figure class="lab" data-alarm="off">
          <svg viewBox="0 0 120 150" class="glass" role="img" aria-label="Vaso con agua cuya turbidez cambia con el control">
            <path id="water" d="M23 40 L97 40 L91.5 136 L28.5 136 Z" fill="#9cc9df"/>
            <path d="M18 14 L102 14 L92 140 L28 140 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
          </svg>
          <div class="panel">
            <div class="readout"><span class="led"></span><output id="ntu" for="turb">2 UNT</output></div>
            <label for="turb">Turbidez del agua</label>
            <input id="turb" type="range" min="0" max="20" step="0.5" value="2" />
            <div class="scale"><span>0</span><span class="lim">límite 5</span><span>20 UNT</span></div>
            <p id="state" class="state">Apta para consumo. LED verde encendido.</p>
            <pre class="code" aria-label="Lógica del programa">si turbidez &gt; 5 entonces
    encender LED rojo
    sonar alarma
si no
    encender LED verde</pre>
          </div>
        </figure>
      </section>

      <section id="proyectos" class="wrap">
        <div class="sec-head"><h2>Proyectos con el modelo</h2></div>
        <ul class="proj">
          {proyectos.map((p) => (
            <li>
              <h3>{p.titulo}</h3>
              <p>{p.quien}</p>
              <p class="dato">{p.dato}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="wrap">
        <div class="sec-head"><h2>Formación docente</h2></div>
        <div class="two">
          <p>
            La UNAT dicta el taller “Fortalecimiento de competencias en el área de Ciencia y Tecnología mediante el modelo IBPT-STEM”
            para docentes de Tayacaja. En las jornadas programan en castellano y quechua, trabajan el enfoque STEM y comparten lo que
            ya probaron en sus aulas. El objetivo es que cada docente pueda unir ciencia, programación e investigación en clases
            pensadas para su propio contexto.
          </p>
          <p>
            Quienes aplican el modelo forman la Red Peruana IBPT-STEM. En la universidad, los estudios publicados muestran mejoras
            significativas en todas las fases en estudiantes de Ingeniería y Enfermería, con mayores avances en planificación y
            reflexión crítica en Enfermería.
          </p>
        </div>
      </section>

      <section id="bibliografia" class="wrap">
        <div class="sec-head"><h2>Bibliografía</h2></div>
        <ul class="fuentes">
          {fuentes.map((s) => (
            <li><a href={s.u} target="_blank" rel="noopener">{s.t}</a>. {s.d}</li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="wrap foot">
      <p>Sitio informativo no oficial, armado con fuentes públicas en octubre de 2026.</p>
      <p>Contacto del autor del modelo: <span class="mono">rpaucarc@unat.edu.pe</span></p>
    </footer>

    <script>
      const r = document.getElementById("turb") as HTMLInputElement;
      const out = document.getElementById("ntu")!;
      const water = document.getElementById("water")!;
      const state = document.getElementById("state")!;
      const lab = document.querySelector(".lab") as HTMLElement;
      const clear = [156, 201, 223], mud = [140, 112, 74];
      const paint = () => {
        const v = Number(r.value);
        const t = v / 20;
        water.setAttribute("fill", `rgb(${clear.map((x, i) => Math.round(x + (mud[i] - x) * t)).join(",")})`);
        out.textContent = `${v.toLocaleString("es-PE")} UNT`;
        const alarm = v > 5;
        lab.dataset.alarm = alarm ? "on" : "off";
        state.textContent = alarm ? "Supera el límite. LED rojo y alarma." : "Apta para consumo. LED verde encendido.";
      };
      r.addEventListener("input", paint);
      paint();
    </script>
  </body>
</html>

<style is:global>
  /* Layout: editorial de una columna, sobrio; un solo acento carmín de los textiles de Huancavelica */
  :root {
    --bg: #fcfcfa;
    --fg: #1b1a19;
    --muted: #63605b;
    --line: #e2dfda;
    --accent: #a3172f;
    --ok: #2f7d4f;
    --serif: "Newsreader", Georgia, "Times New Roman", serif;
    --sans: "Public Sans", system-ui, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #161514; --fg: #ecebe8; --muted: #a29e97; --line: #2e2c2a; --accent: #e3687b; --ok: #6cc28f; color-scheme: dark; }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 17px/1.65 var(--sans); }
  a { color: inherit; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  a:hover { color: var(--accent); }
  a:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .wrap { max-width: 1040px; margin: 0 auto; padding-inline: max(20px, 5vw); }
  .mono { font-family: var(--mono); font-size: 0.9em; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 500; line-height: 1.1; text-wrap: balance; margin: 0; }
  h2 { font-size: clamp(1.8rem, 3.4vw, 2.5rem); letter-spacing: -0.01em; }
  h3 { font-size: 1.3rem; font-weight: 600; }
  section { padding-block: 72px; border-top: 1px solid var(--line); }
  .hero { border-top: 0; padding-top: 56px; }

  .weave {
    height: 10px;
    background:
      linear-gradient(135deg, var(--accent) 25%, transparent 25%) -6px 0 / 12px 10px,
      linear-gradient(225deg, var(--accent) 25%, transparent 25%) -6px 0 / 12px 10px;
  }
  .top { display: flex; justify-content: space-between; align-items: center; padding-block: 20px; gap: 12px; flex-wrap: wrap; }
  .logo { font-weight: 700; letter-spacing: 0.06em; text-decoration: none; font-size: 0.95rem; }
  .top nav { display: flex; gap: 22px; flex-wrap: wrap; font-size: 0.92rem; }
  .top nav a { text-decoration: none; color: var(--muted); }
  .top nav a:hover { color: var(--fg); }

  .eyebrow { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 700; margin: 0 0 20px; }
  h1 { font-size: clamp(2.6rem, 6.4vw, 4.9rem); letter-spacing: -0.02em; max-width: 15ch; font-weight: 400; }
  .hero-cols { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; margin-top: 40px; }
  .lead { margin: 0; font-size: 1.15rem; max-width: 56ch; min-width: 0; }
  .meta { margin: 0; display: flex; flex-direction: column; }
  .meta div { padding-block: 10px; border-bottom: 1px solid var(--line); }
  .meta div:first-child { border-top: 1px solid var(--line); }
  .meta dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .meta dd { margin: 0; font-weight: 600; }

  .quote-sec blockquote { margin: 0 0 0 auto; max-width: 820px; }
  .quote-sec p { font-family: var(--serif); font-size: clamp(1.8rem, 4vw, 3.2rem); line-height: 1.15; letter-spacing: -0.01em; margin: 0; }
  .quote-sec cite { display: block; font-style: normal; color: var(--muted); font-size: 0.92rem; margin-top: 20px; max-width: 60ch; }

  .sec-head { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; align-items: baseline; }
  .sec-head p { margin: 0; color: var(--muted); max-width: 58ch; }

  .fases { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .fases li { border-top: 2px solid var(--fg); padding-top: 18px; min-width: 0; }
  .num { font-family: var(--serif); font-size: 2.6rem; color: var(--accent); line-height: 1; }
  .fases h3 { margin: 14px 0 10px; }
  .fases p { margin: 0; font-size: 0.97rem; }
  .fases .aula { margin-top: 12px; color: var(--muted); font-size: 0.88rem; }

  .lab { margin: 48px 0 0; display: grid; grid-template-columns: 200px 1fr; gap: 48px; align-items: center; padding: 36px; border: 1px solid var(--line); }
  .glass { width: 100%; max-width: 200px; color: var(--fg); }
  #water { transition: fill .15s; }
  .panel { min-width: 0; max-width: 460px; }
  .readout { display: flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 2rem; font-variant-numeric: tabular-nums; }
  .led { width: 14px; height: 14px; border-radius: 50%; background: var(--ok); transition: background .15s; }
  .lab[data-alarm="on"] .led { background: var(--accent); }
  .panel label { display: block; margin-top: 18px; font-weight: 600; font-size: 0.9rem; }
  .panel input { width: 100%; accent-color: var(--accent); margin-top: 8px; }
  .scale { display: flex; justify-content: space-between; position: relative; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); }
  .scale .lim { position: absolute; left: 25%; translate: -50% 0; color: var(--accent); }
  .state { margin: 14px 0 0; font-weight: 600; min-height: 1.6em; }
  .lab[data-alarm="on"] .state { color: var(--accent); }
  .code { margin: 20px 0 0; font-family: var(--mono); font-size: 0.82rem; color: var(--muted); background: transparent; border-left: 2px solid var(--line); padding: 4px 0 4px 14px; white-space: pre; overflow-x: auto; }

  .proj { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  .proj li { padding-block: 22px; border-bottom: 1px solid var(--line); }
  .proj p { margin: 6px 0 0; color: var(--muted); font-size: 0.95rem; }
  .proj .dato { color: var(--fg); font-weight: 600; }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; margin-top: 32px; }
  .two p { margin: 0; }

  .fuentes { list-style: none; padding: 0; margin: 32px 0 0; max-width: 72ch; }
  .fuentes li { padding-left: 2em; text-indent: -2em; margin-bottom: 14px; color: var(--muted); }
  .fuentes a { color: var(--fg); }
  .foot { padding-block: 40px; color: var(--muted); font-size: 0.88rem; border-top: 1px solid var(--line); }
  .foot p { margin: 4px 0; }

  @media (max-width: 860px) {
    .hero-cols, .sec-head, .two, .proj { grid-template-columns: 1fr; gap: 24px; }
    .fases { grid-template-columns: 1fr 1fr; }
    .lab { grid-template-columns: 1fr; padding: 24px; }
    .glass { max-width: 140px; }
  }
  @media (max-width: 520px) { .fases { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } #water, .led { transition: none; } }
</style>
