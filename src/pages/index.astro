---
const fases = [
  {
    n: "1",
    nombre: "Comprensión del problema",
    texto: "El grupo elige un problema real de su comunidad y lo estudia a fondo: qué lo causa, a quién afecta y qué consecuencias tiene.",
    aula: "Identificar el problema, sus causas y sus consecuencias.",
  },
  {
    n: "2",
    nombre: "Elaboración de actividades",
    texto: "Se diseña la solución y se planifica el trabajo paso a paso, con un cronograma de actividades por semana.",
    aula: "Armar el cuadro de actividades y el cronograma.",
  },
  {
    n: "3",
    nombre: "Ejecución e implementación",
    texto: "Se construye y programa el prototipo o maqueta con mBlock y una tarjeta programable con sensores.",
    aula: "Construir, programar y presentar el prototipo.",
  },
  {
    n: "4",
    nombre: "Revisión y evaluación",
    texto: "Se revisa qué falta en el programa y en la maqueta, se corrige y el trabajo se expone ante la clase.",
    aula: "Evaluar, corregir y exponer al cierre de las 18 sesiones.",
  },
];

const proyectos = [
  {
    titulo: "Monitoreo y alerta de turbidez del agua",
    quien: "Estudiantes de la I.E. Mariscal Cáceres, Daniel Hernández",
    dato: "2.º puesto en la Feria Eureka, etapa regional",
  },
  {
    titulo: "Calidad del agua para prevenir infecciones estomacales en Ustuna",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Caso publicado en Sustainability (2025)",
  },
  {
    titulo: "Calidad del aire en casas con cocina a leña",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Simulaciones interactivas en quechua con mBlock",
  },
  {
    titulo: "Control del nivel de ruido en la biblioteca",
    quien: "UNAT, sensor de sonido KY-037",
    dato: "Publicado en la revista Llamkasun",
  },
];

const fuentes = [
  {
    t: "IBPT: An Approach to Promote Research and Technological Competencies in Higher Education",
    d: "Paucar-Curasma, Unsihuay Tovar, Acra-Despradel y Villalba-Condori. Sustainability 17(20), 9309, 2025.",
    u: "https://doi.org/10.3390/su17209309",
  },
  {
    t: "Enfoque IBPT en educación semipresencial",
    d: "Paucar Curasma. EduTicInnova 13(1), 85-93, 2025.",
    u: "https://portalrevistas.aulavirtualusmp.pe/index.php/eduticinnova/article/view/3323",
  },
  {
    t: "Promoting gender equality through computational thinking and STEM activities",
    d: "Revista AiBi, 2025.",
    u: "https://revistas.udes.edu.co/aibi/en/article/view/4073",
  },
  {
    t: "Control y monitoreo del nivel de ruido con el sensor KY-037",
    d: "Revista Llamkasun, UNAT.",
    u: "https://llamkasun.unat.edu.pe/index.php/revista/article/view/143",
  },
  {
    t: "Perfil de Ronald Paucar Curasma",
    d: "ResearchGate.",
    u: "https://www.researchgate.net/profile/Ronald-Paucar-Curasma",
  },
  {
    t: "Página IBPT-STEM",
    d: "Facebook, publicaciones del taller y videos de aula.",
    u: "https://www.facebook.com/ibptstem",
  },
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>IBPT-STEM | Investigación Basada en Problemas y Tecnología</title>
    <meta name="description" content="Modelo pedagógico creado por el Dr. Ronald Paucar Curasma en la Universidad Nacional Autónoma de Tayacaja." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@500;700;800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="wrap top">
      <a class="logo" href="#">IBPT<span>-STEM</span></a>
      <nav>
        <a href="#fases">Fases</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#docentes">Docentes</a>
        <a href="#fuentes">Fuentes</a>
      </nav>
    </header>

    <main>
      <section class="wrap hero">
        <div class="hero-text">
          <p class="where">UNAT · Pampas, Tayacaja, Huancavelica</p>
          <blockquote>
            <p>“Debemos conocer muy bien el problema que vamos a investigar, sus causas, sus consecuencias.”</p>
            <cite>Amelia Pacheco Carhuaricra, docente de 5.º de secundaria, I.E. Mariscal Cáceres</cite>
          </blockquote>
          <p class="lead">
            Así empieza cada proyecto IBPT-STEM. Es un modelo pedagógico creado por el <b>Dr. Ronald Paucar Curasma</b>,
            investigador de la Universidad Nacional Autónoma de Tayacaja. Los estudiantes toman un problema de su comunidad,
            lo investigan y programan un prototipo que lo enfrenta.
          </p>
        </div>

        <figure class="program" aria-label="Programa en bloques de un sistema de alerta de turbidez">
          <div class="blk ev hat">al hacer clic en <span class="flag">▶</span></div>
          <div class="blk ctl c-top">por siempre</div>
          <div class="inner">
            <div class="blk ctl c-top">si <span class="slot op">turbidez &gt; <i>umbral</i></span> entonces</div>
            <div class="inner">
              <div class="blk act">encender LED <span class="pill">rojo</span></div>
              <div class="blk act">sonar alarma</div>
            </div>
            <div class="blk ctl c-mid">si no</div>
            <div class="inner">
              <div class="blk act">encender LED <span class="pill">verde</span></div>
            </div>
            <div class="blk ctl c-end"></div>
          </div>
          <div class="blk ctl c-end"></div>
          <figcaption>Esquema de la lógica del proyecto “Sistema tecnológico para el monitoreo y alerta de turbidez del agua”, armado en mBlock.</figcaption>
        </figure>
      </section>

      <section class="wrap acro">
        <p><b>I</b>nvestigación <b>B</b>asada en <b>P</b>roblemas y <b>T</b>ecnología</p>
        <ul>
          <li><span>se programa en</span>mBlock</li>
          <li><span>se enseña en</span>castellano y quechua</li>
          <li><span>un proyecto dura</span>18 sesiones</li>
          <li><span>se aplica en</span>secundaria y pregrado</li>
        </ul>
      </section>

      <section id="fases" class="wrap">
        <h2>Cuatro fases que encajan una en otra</h2>
        <p class="sub">Igual que los bloques de mBlock, una fase no arranca sin la anterior.</p>
        <ol class="stack">
          {fases.map((f, i) => (
            <li class={`phase p${i + 1}`}>
              <div class="phase-head"><span class="num">Fase {f.n}</span><h3>{f.nombre}</h3></div>
              <p>{f.texto}</p>
              <p class="aula">En el aula: {f.aula}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="proyectos" class="wrap">
        <h2>Lo que ya salió de las aulas</h2>
        <div class="fair">
          {proyectos.map((p, i) => (
            <article class={`card t${i % 4}`}>
              <p class="tag">{p.dato}</p>
              <h3>{p.titulo}</h3>
              <p class="who">{p.quien}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="docentes" class="wrap teach">
        <h2>Docentes que aprenden a enseñar así</h2>
        <div class="teach-body">
          <p>
            La UNAT dicta el taller “Fortalecimiento de competencias en el área de Ciencia y Tecnología mediante el modelo IBPT-STEM”
            para docentes de Tayacaja. En las jornadas programan en castellano y quechua, trabajan el enfoque STEM y comparten lo que
            ya probaron en sus aulas. El objetivo es que cada docente pueda unir ciencia, programación e investigación en clases
            pensadas para su propio contexto.
          </p>
          <p>
            Quienes aplican el modelo forman la Red Peruana IBPT-STEM. En la universidad, los estudios publicados muestran mejoras
            significativas en todas las fases en estudiantes de Ingeniería y Enfermería.
          </p>
        </div>
      </section>

      <section id="fuentes" class="wrap">
        <h2>Fuentes</h2>
        <ul class="fuentes">
          {fuentes.map((s) => (
            <li>
              <a href={s.u} target="_blank" rel="noopener">{s.t}</a>
              <span>{s.d}</span>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="wrap foot">
      <p>Sitio informativo no oficial, armado con fuentes públicas en octubre de 2026.</p>
      <p>Contacto del autor del modelo: <span class="mono">rpaucarc@unat.edu.pe</span></p>
    </footer>
  </body>
</html>

<style is:global>
  /* Layout: hoja de cuaderno cuadriculado (pizarra en oscuro); las fases y el programa son bloques de mBlock */
  :root {
    --paper: #fbfaf5;
    --grid: #dfe6ee;
    --ink: #1d2433;
    --muted: #5a6474;
    --margin: #e5484d;
    --ev: #ffbf00;
    --ctl: #ffab19;
    --sense: #4c97ff;
    --op: #59c059;
    --act: #0fbd8c;
    --block-ink: #1d2433;
    --display: "Rubik", "Arial Rounded MT Bold", system-ui, sans-serif;
    --body: "Atkinson Hyperlegible", system-ui, sans-serif;
    --mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #1e3529;
      --grid: #27443500;
      --ink: #eef3ec;
      --muted: #b5c4b9;
      --margin: #f2a7a0;
    }
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0; color: var(--ink); font: 18px/1.6 var(--body);
    background-color: var(--paper);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  a { color: inherit; text-decoration-thickness: 2px; text-decoration-color: var(--ctl); text-underline-offset: 3px; }
  a:focus-visible { outline: 3px solid var(--sense); outline-offset: 2px; }
  .wrap { max-width: 1120px; margin: 0 auto; padding-inline: max(20px, 4vw); }
  .mono { font-family: var(--mono); font-size: 0.85em; }
  h1, h2, h3 { font-family: var(--display); line-height: 1.1; text-wrap: balance; margin: 0; }
  h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 800; letter-spacing: -0.015em; }
  h3 { font-size: 1.25rem; font-weight: 700; }
  section { padding-block: 64px; }
  .sub { color: var(--muted); margin: 8px 0 0; }

  .top { display: flex; justify-content: space-between; align-items: center; padding-block: 18px; gap: 12px; flex-wrap: wrap; }
  .logo { font-family: var(--display); font-weight: 800; font-size: 1.3rem; text-decoration: none; }
  .logo span { color: var(--ctl); }
  .top nav { display: flex; gap: 18px; flex-wrap: wrap; }
  .top nav a { text-decoration: none; font-weight: 700; font-size: 0.95rem; }
  .top nav a:hover { text-decoration: underline; text-decoration-color: var(--ctl); }

  .hero { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: center; padding-top: 32px; }
  .hero-text { border-left: 2px solid var(--margin); padding-left: 28px; min-width: 0; }
  .where { font-family: var(--display); font-weight: 700; color: var(--muted); margin: 0 0 20px; letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.8rem; }
  blockquote { margin: 0; }
  blockquote p { font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 4.6vw, 3.6rem); line-height: 1.08; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }
  cite { display: block; font-style: normal; color: var(--muted); margin-top: 16px; font-size: 0.95rem; }
  .lead { margin: 28px 0 0; max-width: 58ch; }

  .program { margin: 0; font-family: var(--display); font-weight: 500; font-size: 0.95rem; color: var(--block-ink); min-width: 0; }
  .blk { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 6px; position: relative; min-width: 180px; box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.15); }
  .blk::after { content: ""; position: absolute; left: 18px; bottom: -6px; width: 22px; height: 7px; background: inherit; border-radius: 0 0 5px 5px; z-index: 1; }
  .hat { border-radius: 22px 22px 6px 6px; padding-top: 18px; }
  .ev { background: var(--ev); }
  .ctl { background: var(--ctl); }
  .act { background: var(--act); color: #fff; }
  .c-end { min-height: 18px; min-width: 120px; padding: 0; }
  .c-end::after, .c-top::after, .c-mid::after { left: 34px; }
  .inner { border-left: 18px solid var(--ctl); padding: 4px 0 4px 0; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
  .inner .inner { border-left-color: var(--ctl); }
  .program > .blk, .program > .inner { display: flex; width: fit-content; }
  .program > * + * { margin-top: 2px; }
  .slot { background: var(--op); color: #fff; padding: 4px 12px; border-radius: 999px; }
  .slot i { font-style: normal; background: #fff; color: var(--block-ink); border-radius: 999px; padding: 0 8px; }
  .pill { background: #fff; color: var(--block-ink); border-radius: 999px; padding: 0 10px; }
  .flag { color: #2f9e44; }
  figcaption { font-family: var(--body); font-weight: 400; color: var(--muted); font-size: 0.85rem; margin-top: 18px; max-width: 40ch; }

  .acro { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 24px; padding-block: 32px; border-block: 2px dashed var(--muted); }
  .acro p { font-family: var(--display); font-size: clamp(1.3rem, 2.6vw, 1.8rem); margin: 0; font-weight: 500; }
  .acro b { color: var(--ctl); font-weight: 800; }
  .acro ul { display: flex; flex-wrap: wrap; gap: 28px; list-style: none; padding: 0; margin: 0; }
  .acro li { display: flex; flex-direction: column; font-weight: 700; }
  .acro li span { font-weight: 400; color: var(--muted); font-size: 0.85rem; }

  .stack { list-style: none; padding: 0; margin: 36px 0 0; display: flex; flex-direction: column; }
  .phase { color: var(--block-ink); padding: 22px 26px 26px; border-radius: 8px; max-width: 760px; position: relative; box-shadow: inset 0 -4px 0 rgb(0 0 0 / 0.14); }
  .phase::after { content: ""; position: absolute; left: 36px; bottom: -10px; width: 36px; height: 11px; background: inherit; border-radius: 0 0 8px 8px; z-index: 1; }
  .phase:last-child::after { display: none; }
  .phase + .phase { margin-top: 2px; }
  .p1 { background: var(--ev); }
  .p2 { background: var(--ctl); margin-left: 6%; }
  .p3 { background: var(--op); margin-left: 12%; }
  .p4 { background: var(--sense); margin-left: 18%; color: #fff; }
  .phase-head { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; }
  .num { font-family: var(--mono); font-size: 0.8rem; background: rgb(255 255 255 / 0.55); color: var(--block-ink); padding: 2px 10px; border-radius: 999px; }
  .phase h3 { font-size: 1.5rem; }
  .phase p { margin: 10px 0 0; max-width: 60ch; }
  .phase .aula { font-size: 0.9rem; opacity: 0.85; }

  .fair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; margin-top: 36px; }
  .card { background: var(--paper); color: var(--ink); border: 2px solid var(--ink); padding: 22px; position: relative; box-shadow: 6px 6px 0 var(--ink); }
  .t0 { transform: rotate(-1.2deg); } .t1 { transform: rotate(0.8deg); } .t2 { transform: rotate(-0.5deg); } .t3 { transform: rotate(1.3deg); }
  .card::before { content: ""; position: absolute; top: -12px; left: 50%; width: 70px; height: 22px; translate: -50% 0; background: color-mix(in srgb, var(--ev) 70%, transparent); rotate: -3deg; }
  .tag { font-family: var(--display); font-weight: 700; font-size: 0.8rem; color: var(--margin); text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 10px; }
  .who { color: var(--muted); margin: 10px 0 0; font-size: 0.95rem; }

  .teach-body { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 24px; }
  .teach-body p { margin: 0; }

  .fuentes { list-style: none; padding: 0; margin: 20px 0 0; counter-reset: f; }
  .fuentes li { display: flex; flex-direction: column; padding-block: 12px; border-bottom: 1px solid var(--grid); }
  .fuentes a { font-weight: 700; }
  .fuentes span { color: var(--muted); font-size: 0.9rem; }
  .foot { padding-block: 40px; color: var(--muted); font-size: 0.9rem; }
  .foot p { margin: 4px 0; }

  @media (max-width: 860px) {
    .hero, .teach-body, .fair { grid-template-columns: 1fr; }
    .p2, .p3, .p4 { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>
