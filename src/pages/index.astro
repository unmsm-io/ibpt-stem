---
const fases = [
  {
    n: "1",
    nombre: "Comprensión del problema",
    texto: "El grupo elige un problema real de su comunidad y lo estudia a fondo: qué lo causa, a quién afecta y qué consecuencias tiene.",
    aula: "Identificar el problema, sus causas y sus consecuencias.",
  },
  {
    n: "2",
    nombre: "Elaboración de actividades",
    texto: "Se diseña la solución y se planifica el trabajo paso a paso, con un cronograma de actividades por semana.",
    aula: "Armar el cuadro de actividades y el cronograma.",
  },
  {
    n: "3",
    nombre: "Ejecución e implementación",
    texto: "Se construye y programa el prototipo o maqueta con mBlock y una tarjeta programable con sensores.",
    aula: "Construir, programar y presentar el prototipo.",
  },
  {
    n: "4",
    nombre: "Revisión y evaluación",
    texto: "Se revisa qué falta en el programa y en la maqueta, se corrige y el trabajo se expone ante la clase.",
    aula: "Evaluar, corregir y exponer al cierre de las 18 sesiones.",
  },
];

const proyectos = [
  {
    titulo: "Monitoreo y alerta de turbidez del agua",
    quien: "Estudiantes de la I.E. Mariscal Cáceres, Daniel Hernández",
    dato: "2.º puesto en la Feria Eureka, etapa regional",
  },
  {
    titulo: "Calidad del agua para prevenir infecciones estomacales en Ustuna",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Caso publicado en Sustainability (2025)",
  },
  {
    titulo: "Calidad del aire en casas con cocina a leña",
    quien: "Estudiantes de Enfermería, UNAT",
    dato: "Simulaciones interactivas en quechua con mBlock",
  },
  {
    titulo: "Control del nivel de ruido en la biblioteca",
    quien: "UNAT, sensor de sonido KY-037",
    dato: "Publicado en la revista Llamkasun",
  },
];

const fuentes = [
  {
    t: "IBPT: An Approach to Promote Research and Technological Competencies in Higher Education",
    d: "Paucar-Curasma, Unsihuay Tovar, Acra-Despradel y Villalba-Condori. Sustainability 17(20), 9309, 2025.",
    u: "https://doi.org/10.3390/su17209309",
  },
  {
    t: "Enfoque IBPT en educación semipresencial",
    d: "Paucar Curasma. EduTicInnova 13(1), 85-93, 2025.",
    u: "https://portalrevistas.aulavirtualusmp.pe/index.php/eduticinnova/article/view/3323",
  },
  {
    t: "Promoting gender equality through computational thinking and STEM activities",
    d: "Revista AiBi, 2025.",
    u: "https://revistas.udes.edu.co/aibi/en/article/view/4073",
  },
  {
    t: "Control y monitoreo del nivel de ruido con el sensor KY-037",
    d: "Revista Llamkasun, UNAT.",
    u: "https://llamkasun.unat.edu.pe/index.php/revista/article/view/143",
  },
  {
    t: "Perfil de Ronald Paucar Curasma",
    d: "ResearchGate.",
    u: "https://www.researchgate.net/profile/Ronald-Paucar-Curasma",
  },
  {
    t: "Página IBPT-STEM",
    d: "Facebook, publicaciones del taller y videos de aula.",
    u: "https://www.facebook.com/ibptstem",
  },
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>IBPT-STEM | Investigación Basada en Problemas y Tecnología</title>
    <meta name="description" content="Modelo pedagógico creado por el Dr. Ronald Paucar Curasma en la Universidad Nacional Autónoma de Tayacaja." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="col">
      <header class="s" style="--n:0">
        <h1>IBPT-STEM</h1>
        <p class="dim">Investigación Basada en Problemas y Tecnología</p>
      </header>

      <section class="s" style="--n:1">
        <p>
          Un modelo pedagógico creado por el Dr. Ronald Paucar Curasma en la Universidad Nacional Autónoma de Tayacaja,
          Huancavelica. Los estudiantes toman un problema real de su comunidad, lo investigan y construyen un prototipo
          programado que lo enfrenta.
        </p>
        <p>
          Se enseña en castellano y quechua, con mBlock y tarjetas con sensores, en 18 sesiones por proyecto. Se aplica
          en secundaria y en pregrado.
        </p>
      </section>

      <section class="s" style="--n:2">
        <figure class="demo lab" data-alarm="off">
          <div class="stage">
            <svg viewBox="0 0 120 150" class="glass" role="img" aria-label="Vaso con agua cuya turbidez cambia con el control">
              <defs>
                <clipPath id="cup"><path d="M23.5 40 L96.5 40 L91.6 135 L28.4 135 Z" /></clipPath>
              </defs>
              <g clip-path="url(#cup)">
                <rect id="water" x="0" y="40" width="120" height="100" fill="#a9d2e6" />
                <g id="sed"></g>
              </g>
              <path d="M18 14 L102 14 L92 140 L28 140 Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
            <div class="status">
              <span class="led"></span>
              <span id="state">Apta</span>
            </div>
          </div>
          <div class="controls">
            <label for="turb">Turbidez</label>
            <input id="turb" type="range" min="0" max="20" step="0.5" value="2" />
            <output id="ntu" for="turb">2.0 UNT</output>
          </div>
        </figure>
        <p class="caption">
          El sistema de monitoreo de turbidez de la I.E. Mariscal Cáceres, 2.º puesto en la Feria Eureka regional. Sobre
          5 UNT enciende un LED rojo y una alarma.
        </p>
      </section>

      <section class="s" style="--n:3">
        <h2>Fases</h2>
        <ol class="rows">
          {fases.map((f) => (
            <li>
              <span class="k">{f.n}</span>
              <div>
                <p class="t">{f.nombre}</p>
                <p class="dim">{f.texto}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="s" style="--n:4">
        <blockquote>
          <p>“Debemos conocer muy bien el problema que vamos a investigar, sus causas, sus consecuencias.”</p>
          <cite class="dim">Amelia Pacheco Carhuaricra, docente de 5.º de secundaria</cite>
        </blockquote>
      </section>

      <section class="s" style="--n:5">
        <h2>Proyectos</h2>
        <ul class="rows">
          {proyectos.map((p) => (
            <li class="split">
              <div>
                <p class="t">{p.titulo}</p>
                <p class="dim">{p.quien}</p>
              </div>
              <p class="dim meta">{p.dato}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="s" style="--n:6">
        <h2>Docentes</h2>
        <p>
          La UNAT dicta el taller “Fortalecimiento de competencias en el área de Ciencia y Tecnología mediante el modelo
          IBPT-STEM” para docentes de Tayacaja: programación visual en castellano y quechua, enfoque STEM e intercambio de
          experiencias de aula. Quienes lo aplican forman la Red Peruana IBPT-STEM.
        </p>
        <p class="dim">
          En la universidad, los estudios publicados muestran mejoras significativas en todas las fases en estudiantes de
          Ingeniería y Enfermería.
        </p>
      </section>

      <section class="s" style="--n:7">
        <h2>Bibliografía</h2>
        <ul class="refs">
          {fuentes.map((s) => (
            <li>
              <a href={s.u} target="_blank" rel="noopener">{s.t}<span aria-hidden="true">↗</span></a>
              <span class="dim">{s.d}</span>
            </li>
          ))}
        </ul>
      </section>

      <footer class="s dim small" style="--n:8">
        <p>Sitio informativo no oficial, con fuentes públicas. Octubre de 2026.</p>
        <p>Contacto del autor: <span class="mono">rpaucarc@unat.edu.pe</span></p>
      </footer>
    </main>

    <script>
      const r = document.getElementById("turb") as HTMLInputElement;
      const out = document.getElementById("ntu")!;
      const water = document.getElementById("water")!;
      const sed = document.getElementById("sed")!;
      const state = document.getElementById("state")!;
      const lab = document.querySelector(".lab") as HTMLElement;
      const NS = "http://www.w3.org/2000/svg";
      const h = (n: number) => { const x = Math.sin(n * 12.9898) * 43758.5453; return x - Math.floor(x); };
      const dots = Array.from({ length: 56 }, (_, i) => {
        const c = document.createElementNS(NS, "circle");
        c.setAttribute("cx", String(26 + h(i + 101) * 68));
        c.setAttribute("cy", String(44 + h(i + 1) * 90));
        c.setAttribute("r", String(0.5 + h(i + 7) * 1.1));
        c.style.setProperty("--d", `${-h(i + 3) * 8}s`);
        sed.appendChild(c);
        return c;
      });
      const clear = [169, 210, 230], mud = [150, 126, 92];
      const paint = () => {
        const v = Number(r.value);
        const t = v / 20;
        water.setAttribute("fill", `rgb(${clear.map((x, i) => Math.round(x + (mud[i] - x) * t)).join(",")})`);
        const visible = Math.round(t * dots.length);
        dots.forEach((d, i) => d.classList.toggle("on", i < visible));
        out.textContent = `${v.toFixed(1)} UNT`;
        const alarm = v > 5 ? "on" : "off";
        if (lab.dataset.alarm !== alarm) {
          lab.dataset.alarm = alarm;
          state.textContent = alarm === "on" ? "Alarma" : "Apta";
        }
        r.style.setProperty("--p", `${t * 100}%`);
      };
      r.addEventListener("input", paint);
      paint();
    </script>
  </body>
</html>

<style is:global>
  /* Layout: una columna angosta, un solo tamaño de texto, grises; la demo de turbidez es la pieza central */
  :root {
    --gray-1: #fcfcfc; --gray-2: #f9f9f9; --gray-4: #e8e8e8; --gray-6: #dcdcdc;
    --gray-9: #8d8d8d; --gray-11: #6f6f6f; --gray-12: #171717;
    --red: #e5484d; --green: #30a46c;
    --sans: "Geist", ui-sans-serif, system-ui, sans-serif;
    --mono: "Geist Mono", ui-monospace, Menlo, monospace;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (prefers-color-scheme: dark) {
    :root { --gray-1: #111111; --gray-2: #191919; --gray-4: #2a2a2a; --gray-6: #3a3a3a; --gray-9: #6e6e6e; --gray-11: #b4b4b4; --gray-12: #eeeeee; color-scheme: dark; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--gray-1); color: var(--gray-12); font: 15px/1.65 var(--sans); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  ::selection { background: color-mix(in srgb, var(--gray-12) 14%, transparent); }
  .col { max-width: 600px; margin: 0 auto; padding: 96px max(24px, env(safe-area-inset-right, 0px)) 80px max(24px, env(safe-area-inset-left, 0px)); display: flex; flex-direction: column; gap: 56px; }
  section, header, footer { display: flex; flex-direction: column; gap: 14px; }
  h1, h2 { font-size: 15px; font-weight: 500; margin: 0; letter-spacing: -0.005em; }
  h2 { margin-bottom: 4px; }
  p { margin: 0; text-wrap: pretty; }
  header .dim { margin-top: -10px; }
  .dim { color: var(--gray-11); }
  .small { font-size: 13px; gap: 2px; }
  .mono { font-family: var(--mono); font-size: 13px; }
  a { color: inherit; }
  a:focus-visible, input:focus-visible { outline: 2px solid var(--gray-12); outline-offset: 2px; border-radius: 4px; }

  .s { animation: enter 600ms var(--ease-out) both; animation-delay: calc(var(--n) * 60ms); }
  @keyframes enter { from { opacity: 0; translate: 0 8px; filter: blur(4px); } }

  .demo { margin: 0; border-radius: 12px; background: var(--gray-2); box-shadow: 0 0 0 1px var(--gray-4); overflow: hidden; }
  .stage { position: relative; display: grid; place-items: center; padding: 40px 0 28px; }
  .glass { width: 104px; color: var(--gray-12); }
  #water { transition: fill 300ms var(--ease-out); }
  #sed circle { fill: #5a4630; opacity: 0; transition: opacity 250ms var(--ease-out); animation: drift 8s ease-in-out var(--d) infinite alternate; }
  #sed circle.on { opacity: 0.5; }
  @keyframes drift { from { translate: -1.2px -2.5px; } to { translate: 1.2px 2.5px; } }
  .status { position: absolute; top: 14px; left: 16px; display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--gray-11); }
  .led { width: 7px; height: 7px; border-radius: 50%; background: var(--green); transition: background 150ms ease, box-shadow 150ms ease; box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 18%, transparent); }
  .lab[data-alarm="on"] .led { background: var(--red); box-shadow: 0 0 0 3px color-mix(in srgb, var(--red) 22%, transparent); }
  .lab[data-alarm="on"] #state { color: var(--red); }
  #state { transition: color 150ms ease; }

  .controls { display: grid; grid-template-columns: auto 1fr 72px; align-items: center; gap: 16px; padding: 14px 16px; border-top: 1px solid var(--gray-4); font-size: 13px; }
  .controls label { color: var(--gray-11); }
  .controls output { font-family: var(--mono); text-align: right; font-variant-numeric: tabular-nums; }
  input[type="range"] { appearance: none; -webkit-appearance: none; width: 100%; height: 24px; margin: 0; background: transparent; cursor: grab; touch-action: none; }
  input[type="range"]:active { cursor: grabbing; }
  input[type="range"]::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(to right, var(--gray-12) var(--p, 10%), var(--gray-6) var(--p, 10%)); }
  input[type="range"]::-moz-range-track { height: 4px; border-radius: 4px; background: var(--gray-6); }
  input[type="range"]::-moz-range-progress { height: 4px; border-radius: 4px; background: var(--gray-12); }
  input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; margin-top: -6px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12), 0 1px 3px rgb(0 0 0 / 0.18); transition: scale 160ms var(--ease-out); }
  input[type="range"]::-moz-range-thumb { width: 16px; height: 16px; border: 0; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12), 0 1px 3px rgb(0 0 0 / 0.18); }
  input[type="range"]:active::-webkit-slider-thumb { scale: 1.12; }
  .caption { font-size: 13px; color: var(--gray-11); margin-top: -2px; }

  .rows { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 18px; }
  .rows li { display: grid; grid-template-columns: 24px 1fr; gap: 8px; }
  .rows .k { font-family: var(--mono); font-size: 13px; color: var(--gray-9); padding-top: 1px; font-variant-numeric: tabular-nums; }
  .rows .t { font-weight: 500; }
  .rows li.split { grid-template-columns: 1fr auto; gap: 24px; }
  .rows .meta { font-size: 13px; text-align: right; max-width: 200px; }

  blockquote { margin: 0; padding-left: 16px; border-left: 1px solid var(--gray-6); display: flex; flex-direction: column; gap: 8px; }
  blockquote p { font-size: 17px; line-height: 1.5; letter-spacing: -0.01em; }
  cite { font-style: normal; font-size: 13px; }

  .refs { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .refs li { display: flex; flex-direction: column; }
  .refs .dim { font-size: 13px; }
  .refs a { text-decoration: underline; text-decoration-color: var(--gray-6); text-underline-offset: 3px; transition: text-decoration-color 150ms ease; }
  .refs a span { display: inline-block; margin-left: 4px; color: var(--gray-9); font-size: 12px; transition: translate 160ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .refs a:hover { text-decoration-color: var(--gray-12); }
    .refs a:hover span { translate: 1px -1px; }
  }

  @media (max-width: 520px) {
    .col { padding-top: 64px; gap: 48px; }
    .rows li.split { grid-template-columns: 1fr; gap: 4px; }
    .rows .meta { text-align: left; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .s, #sed circle { animation: none; }
    #water, .led, #sed circle { transition: none; }
  }
</style>
